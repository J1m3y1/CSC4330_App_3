# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── PostgreSQL ───────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fantasi
DB_USER=fantasi_user
DB_PASSWORD=your_strong_password_here

# ── JWT ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_byte_random_hex
JWT_EXPIRES_IN=15m

# ── Refresh Token ────────────────────────────────────────
REFRESH_TOKEN_SECRET=replace_with_different_64_byte_random_hex
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Password Reset ───────────────────────────────────────
RESET_TOKEN_EXPIRES_MINUTES=30

# ── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# ── File Uploads ─────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# ── App URL ───────────────────────────────────────────────
# Used to build links in outgoing emails (password reset, etc.)
APP_URL=http://localhost:5000

# ── Payments ──────────────────────────────────────────────
# Fantasi has no payment processor wired in — mainstream processors (Stripe,
# PayPal, Square) don't underwrite this kind of content. Membership upgrades
# go through membership_requests: a member requests a tier
# (POST /api/membership/request), an admin reviews it in /AdminPage/Admin.html
# and grants it manually. If you later integrate a high-risk processor
# (CCBill, Segpay, Epoch, Vendo) or crypto payments, wire its webhook/postback
# to call the same grantMembership() in controllers/membershipController.js.

# ── Twilio Verify (phone verification) ────────────────────
# Optional in development — send-code/verify-code return 503 until these
# are set. Create a Verify Service at https://console.twilio.com/us1/develop/verify/services
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ── SMTP (transactional email) ────────────────────────────
# Optional in development — emails are logged to the console instead of
# sent until these are set. Any standard SMTP provider works (Postmark,
# SES, SendGrid, Resend's SMTP endpoint, etc.).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Fantasi <no-reply@fantasi.example>
