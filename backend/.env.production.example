# ============================================================
# Fantasi — PRODUCTION environment template
# Copy this to .env on the production host (or paste these into your
# host's secret/env-var manager — Render, Railway, Fly, a VPS, etc.) and
# fill in every TODO. Never commit a real filled-in .env anywhere — it's
# already gitignored, keep it that way.
# ============================================================

# ── Server ──────────────────────────────────────────────
# Many hosts (Render, Railway, Heroku-style PaaS) inject their own PORT —
# leave this as a fallback; don't fight the platform's assigned port.
PORT=5000
NODE_ENV=production

# ── PostgreSQL ───────────────────────────────────────────
# TODO: point at your production database, not localhost.
DB_HOST=TODO_production_db_host
DB_PORT=5432
DB_NAME=fantasi
DB_USER=TODO_production_db_user
DB_PASSWORD=TODO_production_db_password

# ── JWT ─────────────────────────────────────────────────
# TODO: two DIFFERENT freshly-generated secrets — never reuse the dev
# values from backend/.env. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=TODO_generate_fresh_64_byte_hex
JWT_EXPIRES_IN=15m

# ── Refresh Token ────────────────────────────────────────
REFRESH_TOKEN_SECRET=TODO_generate_a_DIFFERENT_fresh_64_byte_hex
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Password Reset ───────────────────────────────────────
RESET_TOKEN_EXPIRES_MINUTES=30

# ── CORS ─────────────────────────────────────────────────
# TODO: your real production domain(s), comma-separated. Required at boot
# in production — server.js exits immediately if this is unset (see
# config/validateEnv.js). Must match APP_URL below (same origin).
ALLOWED_ORIGINS=https://TODO-your-domain.example

# ── File Uploads ─────────────────────────────────────────
# TODO: confirm the production host gives this a PERSISTENT disk. Most
# PaaS platforms wipe local disk on every deploy/restart — if that's your
# host, avatars/photos/ID documents will vanish. Either pick a host with a
# persistent volume, or move storage to object storage (S3, R2, etc.)
# before going live — this has NOT been done yet as of this template.
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# ── App URL ───────────────────────────────────────────────
# TODO: your real production domain, https, no trailing slash.
APP_URL=https://TODO-your-domain.example

# ── Payments ──────────────────────────────────────────────
# Still invite-only / admin-granted, no processor wired in — see
# backend/README.md. Nothing to fill in here unless that's changed.

# ── Twilio Verify (phone verification) ────────────────────
# TODO: fill in once you've decided whether to launch with phone
# verification enabled. Leaving these blank means send-code/verify-code
# return 503 — sign-up still works, phone verification is just skippable.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ── SMTP (transactional email) ────────────────────────────
# TODO: real SMTP relay credentials (NOT an HTTP API key — see the SMTP2GO
# note in backend/README.md if using SMTP2GO specifically: use their SMTP
# Users credentials, not the api- key). Leaving these blank means password
# reset emails only log to the console — do not launch like that.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Fantasi <no-reply@TODO-your-domain.example>
